#!/usr/bin/env bash
# bin/waktusolat-cli
#
# Copyright (c) 2026 waktusolat-NajibMalaysia
# Licensed under the BSD 3-Clause License. See LICENSE file for details.
#
# PORTED from xmonad-config-NajibMalaysia bin/waktusolat's `-o cli` mode.
# Unlike the renderers, this does its OWN live fetch -- it does not depend
# on waktusolat-fetchd running, which makes it handy for quickly checking a
# zone code or debugging without touching the daemon/lock/neutral-JSON file
# at all.
#
# Usage:
#   waktusolat-cli SGR01

set -euo pipefail
: "${USER:=$(id -un)}"

LIB_DIR="${WAKTUSOLAT_LIB_DIR:-$(dirname "$(readlink -f "$0")")/../lib}"
source "${LIB_DIR}/logger.sh"
source "${LIB_DIR}/jakim-fetch.sh"

set_log_file "/tmp/${USER}-waktusolat-cli.log"
set_log_level "${WAKTUSOLAT_LOGLEVEL:-INFO}"

zone="${1:-}"
if [[ -z "$zone" ]]; then
    echo "Usage: $(basename "$0") ZONE" >&2
    echo "Example: $(basename "$0") SGR01" >&2
    exit 1
fi

resetData
fetchDataZone "$zone"

if [[ ! -s "$RAW_FETCH_FILE" ]]; then
    echo "Error: Failed to fetch data from e-solat. Check your internet or ${LOG_FILE}" >&2
    exit 1
fi

extractData

if [[ ${#NAMASOLAT[@]} -eq 0 ]]; then
    echo "Error: Data extraction failed. The API response might have changed." >&2
    exit 1
fi

echo "----------------------------------------"
echo " Waktu Solat"
echo " Zon: $ZON"
echo " Hari: $DAY"
echo " Tarikh: (M) ${MDATE}, (H) ${HDATE}"
echo "----------------------------------------"
for i in "${!NAMASOLAT[@]}"; do
    printf "%-10s : %s\n" " ${NAMASOLAT[$i]}" "${MASASOLAT[$i]}"
done
echo "----------------------------------------"
