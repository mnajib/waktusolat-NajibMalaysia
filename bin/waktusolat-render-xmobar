#!/usr/bin/env bash
# bin/waktusolat-render-xmobar
#
# Copyright (c) 2026 waktusolat-NajibMalaysia
# Licensed under the BSD 3-Clause License. See LICENSE file for details.
#
# One-shot renderer for xmobar. Reads the canonical NEUTRAL_DATA_FILE
# (written by waktusolat-fetchd) and prints a single xmobar `<fc=...>`
# formatted line to stdout.
#
# CHANGED from the old bin/waktusolat hbar mode: this does NOT loop or
# sleep. xmobar itself is responsible for calling this repeatedly via
# `Run Com`, using its own polling interval -- see the xmobarrc snippet in
# README.md. That interval also drives the near-prayer-time blink effect
# (toggle color derived from `date +%s` parity, so no state needs to persist
# between invocations of this script).
#
# by Muhammad Najib Bin Ibrahim <mnajib@gmail.com>

set -euo pipefail
: "${USER:=$(id -un)}"

LIB_DIR="${WAKTUSOLAT_LIB_DIR:-$(dirname "$(readlink -f "$0")")/../lib}"
source "${LIB_DIR}/logger.sh"
source "${LIB_DIR}/format-helpers.sh"
source "${LIB_DIR}/xmobar-colorize.sh"

# SILENT by default: this script runs roughly once per second under
# xmobar's Run Com, so DEBUG logging here would spam the log file fast.
set_log_file "/tmp/${USER}-waktusolat-render-xmobar.log"
set_log_level "${WAKTUSOLAT_LOGLEVEL:-SILENT}"

# CHANGED (multi-host support): NEUTRAL_DATA_FILE is now
# <WAKTUSOLAT_DATA_DIR>/<WAKTUSOLAT_ZONE>.json instead of a fixed
# $USER-scoped /tmp path -- this is the same file waktusolat-fetchd writes
# to, whether it got the data via the aggregator or a direct JAKIM fetch.
# The renderer doesn't know or care which; it just reads the result.
ZONE="${WAKTUSOLAT_ZONE:-SGR01}"
DATA_DIR="${WAKTUSOLAT_DATA_DIR:-/var/cache/waktusolat}"
NEUTRAL_DATA_FILE="${DATA_DIR}/${ZONE}.json"

if [[ ! -s "$NEUTRAL_DATA_FILE" ]]; then
    echo "<fc=#888888>waktusolat-fetchd: no data yet</fc>"
    exit 0
fi

zone=$(jq -r '.zone' "$NEUTRAL_DATA_FILE")
hdate=$(jq -r '.hijri_date' "$NEUTRAL_DATA_FILE")
mdatetime_server=$(jq -r '.server_time' "$NEUTRAL_DATA_FILE")
day=$(jq -r '.day' "$NEUTRAL_DATA_FILE")
is_stale=$(jq -r '.is_stale' "$NEUTRAL_DATA_FILE")

mDate=$(echo "$mdatetime_server" | sed 's/ .*$//g')
mTime=$(echo "$mdatetime_server" | sed 's/^.* //g')

MMONTHNUMBER=$(echo "$mDate" | awk -F- '{print $2}')
MMONTHFULLNAME=$(namaBulanM "$MMONTHNUMBER")
HMONTHNUMBER=$(echo "$hdate" | awk -F- '{print $2}')
HMONTHFULLNAME=$(namaBulanH "$HMONTHNUMBER")

nomborHari=$(nomHari "$day")
nomborNextHari=$(nomNextHari "$nomborHari")
hariInBM=$(namaHariBM "$nomborHari")
nextHariInBM=$(namaHariBM "$nomborNextHari")

# Prayer name (Bahasa Malaysia) -> time, read straight from JSON.
declare -A T
while IFS=$'\t' read -r name_bm ptime; do
    T["$name_bm"]="$ptime"
done < <(jq -r '.prayers[] | [.name_bm, .time] | @tsv' "$NEUTRAL_DATA_FILE")

cBlue="00ffff"; cYellow="ffff00"; cPink="ff66ff"; cGrey="888888"

out=""
out+="<fc=#${cGrey}>Data ${mDate} ${mTime};</fc> "
if [[ "$is_stale" == "true" ]]; then
    out+="<fc=#ffffff,#ff4d4d>OLD</fc>"
else
    out+="   "
fi
out+=" "
out+="<fc=#${cPink}>(${zone}</fc>"
out+=" <fc=#${cBlue}>(${MMONTHFULLNAME:0:3}</fc>"
out+=" <fc=#${cBlue}>${mDate}</fc>"
out+=" <fc=#${cBlue}>${day:0:3}</fc>"
out+=" <fc=#${cYellow}>(${HMONTHFULLNAME}</fc>"
out+=" <fc=#${cYellow}>${hdate}</fc>"
out+=" <fc=#${cYellow}>${hariInBM:0:3}</fc> "
out+="<fc=#000000,#ffffff>Ims</fc><fc=#000000,#00ff00> ${T[Imsak]} </fc> "
out+="<fc=#000000,#ffffff>Fjr</fc><fc=#000000,#00ff00> ${T[Subuh]} </fc> "
out+="<fc=#000000,#ffffff>Syu</fc><fc=#000000,#00ff00> ${T[Syuruk]} </fc> "
out+="<fc=#000000,#ffffff>Zhr</fc><fc=#000000,#00ff00> ${T[Zohor]} </fc> "
out+="<fc=#000000,#ffffff>Asr</fc><fc=#000000,#00ff00> ${T[Asar]} </fc>"
out+="<fc=#${cYellow}>)</fc> <fc=#${cYellow}>(${nextHariInBM:0:3}</fc> "
out+="<fc=#000000,#ffffff>Mgh</fc><fc=#000000,#00ff00> ${T[Maghrib]} </fc> "
out+="<fc=#000000,#ffffff>Isy</fc><fc=#000000,#00ff00> ${T[Isyak]} </fc>"
out+="<fc=#${cYellow}>)</fc><fc=#${cBlue}>)</fc><fc=#${cPink}>)</fc>"

current_time=$(date +"%H:%M")
# CHANGED: toggle is derived from wall-clock-second parity instead of a
# manually incremented loop counter, since this script no longer loops --
# it's called fresh by xmobar every ~1s, so parity of `date +%s` gives the
# same alternating blink effect without needing any persisted state.
toggle=$(( $(date +%s) % 2 ))

pure_process_prayer_entry "$out" "$current_time" "$toggle"
