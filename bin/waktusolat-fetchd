#!/usr/bin/env bash
# bin/waktusolat-fetchd
#
# Copyright (c) 2026 waktusolat-NajibMalaysia
# Licensed under the BSD 3-Clause License. See LICENSE file for details.
#
#  Singleton daemon: fetch waktu solat from JAKIM, write a canonical,
#  window-manager-agnostic JSON file. Whether xmonad, Niri, both, or neither
#  is running has no bearing on this process -- exactly one instance of this
#  daemon should exist per $USER, guarded by flock below.
#
#  by Muhammad Najib Bin Ibrahim <mnajib@gmail.com>
#
#  Usage:
#      waktusolat-fetchd SGR01
#      waktusolat-fetchd WLY01
#
#  Intended to run under `systemd --user` (see module/home-manager.nix),
#  but can be run directly from a terminal for testing.

set -euo pipefail

: "${USER:=$(id -un)}"

# --- source libraries ----------------------------------------------------
# WAKTUSOLAT_LIB_DIR is set by the Nix wrapper (see flake.nix `wrapProgram`).
# Fall back to a path relative to this script for running from a checkout.
LIB_DIR="${WAKTUSOLAT_LIB_DIR:-$(dirname "$(readlink -f "$0")")/../lib}"
source "${LIB_DIR}/logger.sh"
source "${LIB_DIR}/jakim-fetch.sh"

# --- config ----------------------------------------------------------------
LOGLEVEL="${WAKTUSOLAT_LOGLEVEL:-INFO}"   # SILENT|ERROR|WARN|INFO|DEBUG
LOCKFILE="/tmp/${USER}-waktusolat-fetchd.lock"

zone="${1:-}"
if [[ -z "$zone" ]]; then
    echo "Usage: $(basename "$0") ZONE" >&2
    echo "Example: $(basename "$0") SGR01" >&2
    exit 1
fi

set_log_file "/tmp/${USER}-waktusolat-fetchd.log"
set_log_level "$LOGLEVEL"
log_debug "Begin bin/waktusolat-fetchd (zone=${zone})"

# --- singleton guard -------------------------------------------------------
# CHANGED from xmonad-config's version: the lock is now taken *before* doing
# anything else and independent of an "-o hbar" flag -- this script only
# does one thing, so there is no mode to select. If a second instance is
# started (e.g. Niri's config also tries to spawn this), it exits cleanly.
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    log_info "Another waktusolat-fetchd instance is already running (lock: ${LOCKFILE}). Exiting."
    echo "waktusolat-fetchd is already running for zone tracking. Exiting." >&2
    exit 0
fi

# --- graceful shutdown for systemd -----------------------------------------
running=true
on_term() {
    log_info "Received termination signal, shutting down."
    running=false
}
trap on_term SIGTERM SIGINT

# --- intervals ---------------------------------------------------------
INTERVAL_NORMAL=$(( 60 * 60 * 3 ))  # 3 hours: refetch cadence when data is good
INTERVAL_RETRY=$(( 60 * 1 ))        # 1 minute: refetch cadence after a failed fetch

log_info "waktusolat-fetchd started for zone: ${zone}"

while $running; do
    log_debug "-------------------------------"
    log_debug "$(date) : Start fetch cycle"

    resetData
    fetchDataZone "$zone"
    extractData
    checkData
    log_debug "ERROR --> ${ERROR}"

    interval=$INTERVAL_NORMAL
    if $ERROR; then
        log_debug "Fetch/parse failed: falling back to last good backup, shortening retry interval"
        resetData
        interval=$INTERVAL_RETRY
        getOldGoodFetchData
        extractData
    else
        log_debug "Fetch OK: backing up raw data"
        doBackup
    fi

    impure_write_neutral_json

    log_debug "Sleeping ${interval}s until next fetch cycle"
    # Sleep in small increments so SIGTERM/SIGINT (from systemd stop, or
    # Ctrl-C in a terminal) is honoured promptly instead of waiting out a
    # full 3-hour sleep.
    slept=0
    while $running && (( slept < interval )); do
        sleep 1
        slept=$(( slept + 1 ))
    done
done

log_info "waktusolat-fetchd stopped."
log_debug "End bin/waktusolat-fetchd"
