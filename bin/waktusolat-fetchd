#!/usr/bin/env bash
# bin/waktusolat-fetchd
#
# Copyright (c) 2026 waktusolat-NajibMalaysia
# Licensed under the BSD 3-Clause License. See LICENSE file for details.

set -euo pipefail
umask 022

: "${USER:=$(id -un)}"

# --- source libraries ----------------------------------------------------
LIB_DIR="${WAKTUSOLAT_LIB_DIR:-$(dirname "$(readlink -f "$0")")/../lib}"
source "${LIB_DIR}/logger.sh"
source "${LIB_DIR}/jakim-fetch.sh"
source "${LIB_DIR}/aggregator-client.sh"

# --- config ----------------------------------------------------------------
LOGLEVEL="${WAKTUSOLAT_LOGLEVEL:-INFO}"
AGGREGATOR_URL="${WAKTUSOLAT_AGGREGATOR_URL:-}"        # empty => origin role
AGGREGATOR_TIMEOUT="${WAKTUSOLAT_AGGREGATOR_TIMEOUT:-3}"
DATA_DIR="${WAKTUSOLAT_DATA_DIR:-/var/cache/waktusolat}"

zone="${1:-}"
if [[ -z "$zone" ]]; then
    echo "Usage: $(basename "$0") ZONE" >&2
    echo "Example: $(basename "$0") SGR01" >&2
    exit 1
fi

# Ensure both primary data dir and secondary cache path are defined for aggregator/origin role
PRIMARY_DIR="$DATA_DIR"
SECONDARY_DIR=""

if [[ -z "$AGGREGATOR_URL" ]]; then
    # In origin/aggregator mode, guarantee sync to /var/cache/waktusolat alongside primary
    if [[ "$PRIMARY_DIR" == "/var/lib/waktusolat" ]]; then
        SECONDARY_DIR="/var/cache/waktusolat"
    elif [[ "$PRIMARY_DIR" == "/var/cache/waktusolat" ]]; then
        SECONDARY_DIR="/var/lib/waktusolat"
    fi
fi

mkdir -p "$PRIMARY_DIR"
[[ -n "$SECONDARY_DIR" ]] && mkdir -p "$SECONDARY_DIR"

init_waktusolat_paths "$zone" "$PRIMARY_DIR" "$SECONDARY_DIR"

set_log_file "/tmp/${USER}-waktusolat-fetchd-${zone}.log"
set_log_level "$LOGLEVEL"
log_debug "Begin bin/waktusolat-fetchd (zone=${zone})"
if [[ -n "$AGGREGATOR_URL" ]]; then
    log_info "Role: client (aggregator=${AGGREGATOR_URL}, timeout=${AGGREGATOR_TIMEOUT}s)"
else
    log_info "Role: origin (fetching JAKIM directly)"
fi

# --- singleton guard (per zone) --------------------------------------------
LOCKFILE="/tmp/${USER}-waktusolat-fetchd-${zone}.lock"
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    log_info "Another waktusolat-fetchd instance for zone ${zone} is already running. Exiting."
    echo "waktusolat-fetchd is already running for zone ${zone}. Exiting." >&2
    exit 0
fi

# --- graceful shutdown for systemd -----------------------------------------
running=true
on_term() {
    log_info "Received termination signal, shutting down."
    running=false
}
trap on_term SIGTERM SIGINT

# --- intervals & adaptive backoff config ------------------------------------
INTERVAL_NORMAL=$(( 60 * 60 * 3 ))    # 3h: cadence after a good direct JAKIM fetch
INTERVAL_AGGREGATOR=$(( 60 * 5 ))     # 5m: cadence for polling local aggregator
MIN_RETRY_INTERVAL=30                 # 30s: initial retry backoff on failure
MAX_RETRY_INTERVAL=900                # 15m: maximum cap for backoff retries

current_retry_interval=$MIN_RETRY_INTERVAL

calculate_jitter() {
    echo $(( RANDOM % 10 + 1 ))
}

do_direct_fetch_old() {
    resetData
    fetchDataZone "$zone"
    extractData
    checkData
    log_debug "ERROR --> ${ERROR}"

    if $ERROR; then
        log_warn "Direct fetch/parse failed for zone ${zone}: restoring backup cache and setting is_stale=true"
        resetData
        getOldGoodFetchData
        extractData
    else
        log_debug "Direct fetch OK: backing up raw data"
        doBackup
    fi

    impure_write_neutral_json
}

do_direct_fetch() {
    resetData
    fetchDataZone "$zone"
    extractData
    checkData
    log_debug "ERROR --> ${ERROR}"

    if $ERROR; then
        log_warn "Direct fetch/parse failed for zone ${zone}: restoring backup cache and setting is_stale=true"
        resetData
        getOldGoodFetchData
        extractData
    else
        log_debug "Direct fetch OK: backing up raw data"
        doBackup
    fi

    # Write out the raw JAKIM JSON response for external consumers
    if [[ -f "$RAW_FETCH_FILE" ]]; then
        local raw_dest="${PRIMARY_DIR}/raw-${zone}.json"
        local raw_dest_general="${PRIMARY_DIR}/raw.json"

        cp "$RAW_FETCH_FILE" "$raw_dest"
        chmod 0644 "$raw_dest"

        # Keep a generic symlink or copy for easy un-parameterized consumption
        cp "$RAW_FETCH_FILE" "$raw_dest_general"
        chmod 0644 "$raw_dest_general"

        if [[ -n "$SECONDARY_DIR" ]]; then
            cp "$RAW_FETCH_FILE" "${SECONDARY_DIR}/raw-${zone}.json"
            cp "$RAW_FETCH_FILE" "${SECONDARY_DIR}/raw.json"
        fi
        log_debug "Published raw JAKIM JSON to ${raw_dest}"
    fi

    impure_write_neutral_json
}

log_info "waktusolat-fetchd started for zone: ${zone} -> ${NEUTRAL_DATA_FILE}"

while $running; do
    log_debug "-------------------------------"
    log_debug "$(date) : Start fetch cycle"

    interval=$INTERVAL_NORMAL

    if [[ -n "$AGGREGATOR_URL" ]]; then
        if impure_try_fetch_from_aggregator "$AGGREGATOR_URL" "$zone" "$AGGREGATOR_TIMEOUT" "$NEUTRAL_DATA_FILE"; then
            log_info "Data refreshed via aggregator"
            interval=$INTERVAL_AGGREGATOR
            current_retry_interval=$MIN_RETRY_INTERVAL
        else
            log_info "Aggregator unreachable, falling back to direct JAKIM fetch"
            do_direct_fetch
            if $ERROR; then
                jitter=$(calculate_jitter)
                interval=$(( current_retry_interval + jitter ))
                log_warn "Direct fetch failed. Backoff retry scheduled in ${interval}s (base interval: ${current_retry_interval}s)"

                current_retry_interval=$(( current_retry_interval * 2 ))
                if (( current_retry_interval > MAX_RETRY_INTERVAL )); then
                    current_retry_interval=$MAX_RETRY_INTERVAL
                fi
            else
                interval=$INTERVAL_NORMAL
                current_retry_interval=$MIN_RETRY_INTERVAL
            fi
        fi
    else
        do_direct_fetch
        if $ERROR; then
            jitter=$(calculate_jitter)
            interval=$(( current_retry_interval + jitter ))
            log_warn "Direct fetch failed. Backoff retry scheduled in ${interval}s (base interval: ${current_retry_interval}s)"

            current_retry_interval=$(( current_retry_interval * 2 ))
            if (( current_retry_interval > MAX_RETRY_INTERVAL )); then
                current_retry_interval=$MAX_RETRY_INTERVAL
            fi
        else
            interval=$INTERVAL_NORMAL
            current_retry_interval=$MIN_RETRY_INTERVAL
        fi
    fi

    log_debug "Sleeping ${interval}s until next fetch cycle"
    slept=0
    while $running && (( slept < interval )); do
        sleep 1
        slept=$(( slept + 1 ))
    done
done

log_info "waktusolat-fetchd stopped."
log_debug "End bin/waktusolat-fetchd"
