#!/usr/bin/env bash
# bin/waktusolat-reminder
#
# Copyright (c) 2026 waktusolat-NajibMalaysia
# Licensed under the BSD 3-Clause License. See LICENSE file for details.

set -euo pipefail

MODE="user"
ZONE="SGR01"

# Parse arguments cleanly
while [[ "$#" -gt 0 ]]; do
    case $1 in
        --mode) MODE="$2"; shift 2 ;;
        --zone) ZONE="$2"; shift 2 ;;
        *) echo "Unknown parameter passed: $1" >&2; exit 1 ;;
    esac
done

# Dynamic Directory Resolution
LIB_DIR="${WAKTUSOLAT_LIB_DIR:-$(dirname "$(readlink -f "$0")")/../lib}"
export LIB_DIR
source "${LIB_DIR}/prayer-proximity.sh"
FORMATTER_DIR="${WAKTUSOLAT_FORMATTER_DIR:-${LIB_DIR}/formatters}"
#USER_FORMATTER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/waktusolat/formatters"
USER_FORMATTER_DIR="${XDG_CONFIG_HOME:-${HOME:-/var/empty}/.config}/waktusolat/formatters"
DATA_DIR="${WAKTUSOLAT_DATA_DIR:-/var/cache/waktusolat}"

#
# NOTE:
#
#   located on regular drive, use for store data that not too frequent write
#   - DATA_DIR:   /var/cache/waktusolat/
#
#   located on tmpfs (RAM drive), use for store data that frequent write/read
#   - STATE_DIR:  /var/run/waktusolat/  that is a symlink to /run/waktusolat
#

CACHE_FILE="${DATA_DIR}/${ZONE}.json"

# Determine output directory based on mode (System vs Home Manager)
if [[ "$MODE" == "system" ]]; then
    STATE_DIR="/run/waktusolat"
else
    RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    STATE_DIR="${RUNTIME_DIR}/waktusolat"
fi

mkdir -p "$STATE_DIR"

# Hijri month lookup array
get_hijri_month_name() {
    local m="${1#0}" # remove leading zero
    local months=("" "Muharram" "Safar" "Rabiulawal" "Rabiulakhir" "Jamadilawal" "Jamadilakhir" "Rejab" "Syaaban" "Ramadan" "Syawal" "Zulkaedah" "Zulhijjah")
    echo "${months[$m]:-}"
}

# Hijri day name lookup (BM traditional)
get_hijri_day_name() {
    case "$1" in
        Sun|Sunday)    echo "Aha" ;;
        Mon|Monday)    echo "Isn" ;;
        Tue|Tuesday)   echo "Sel" ;;
        Wed|Wednesday) echo "Rab" ;;
        Thu|Thursday)  echo "Kha" ;;
        Fri|Friday)    echo "Jum" ;;
        Sat|Saturday)  echo "Sab" ;;
        *) echo "Aha" ;;
    esac
}

# Next Hijri day lookup for Maghrib/Isyak transition
get_next_hijri_day_name() {
    case "$1" in
        Aha) echo "Isn" ;;
        Isn) echo "Sel" ;;
        Sel) echo "Rab" ;;
        Rab) echo "Kha" ;;
        Kha) echo "Jum" ;;
        Jum) echo "Sab" ;;
        Sab) echo "Aha" ;;
        *)   echo "Isn" ;;
    esac
}

# Execute active plugin scripts
run_formatters() {
    local plugin
    if [[ -d "$FORMATTER_DIR" ]]; then
        for plugin in "$FORMATTER_DIR"/*.sh; do
            [[ -x "$plugin" ]] && "$plugin"
        done
    fi

    if [[ -d "$USER_FORMATTER_DIR" ]]; then
        for plugin in "$USER_FORMATTER_DIR"/*.sh; do
            [[ -x "$plugin" ]] && "$plugin"
        done
    fi
}

LAST_CACHE_MTIME=0

while true; do

    #
    # stat (System Call / Command): A utility and kernel system call that queries a file's metadata (such as modification time, permissions, or file size) without opening or reading the actual file data.
    # Executing stat every 0.5 seconds spawns two external binary processes per second (stat). On modern hardware running Linux, spawning 2 lightweight process calls per second consumes less than 0.01% CPU usage, which is negligible and will not impact system performance.
    # If you want to eliminate the external stat process fork entirely so that the main loop uses 0% process spawning overhead, you can replace stat with Bash's built-in file test operator test -nt (newer than) against a local reference variable or timestamp file.
    # However, the current setup is already completely safe for disk health and performance.
    #
    # Get the last modification time of the cache file
    CURRENT_MTIME=$(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)

    # Only run jq and static date parsing if the file has been updated
    if [[ "$CURRENT_MTIME" != "$LAST_CACHE_MTIME" ]] && [[ -f "$CACHE_FILE" ]]; then
        IFS=$'\t' read -r IS_STALE SERVER_TIME MDATE HDATE DAY FJR SYU ZHR ASR MGH ISY < <(
            jq -r '
              def p(bm; key):
                if .prayers | type == "array" then
                  (.prayers[] | select(.name_bm == bm).time) // "-"
                else
                  .prayers[key] // "-"
                end;
              [
                (if .is_stale == null then true else .is_stale end | tostring),
                (.server_time // .last_updated // "-"),
                (.gregorian_date // .date // "-"),
                (.hijri_date // "-"),
                (.day // "-"),
                p("Subuh"; "fajr"),
                p("Syuruk"; "syuruk"),
                p("Zohor"; "dhuhr"),
                p("Asar"; "asr"),
                p("Maghrib"; "maghrib"),
                p("Isyak"; "isha")
              ] | @tsv
            ' "$CACHE_FILE"
        )

        # Convert Gregorian Date / Day
        if [[ "$MDATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            G_DATE_ISO="$MDATE"
        else
            G_DATE_ISO=$(date -d "$MDATE" +"%Y-%m-%d" 2>/dev/null || date +"%Y-%m-%d")
        fi

        G_MONTH_ABB=$(date -d "$G_DATE_ISO" +"%b" 2>/dev/null || echo "Aug")
        G_DAY_ABB=$(date -d "$G_DATE_ISO" +"%a" 2>/dev/null || echo "Sun")

        # Extract Hijri Month & Day
        IFS='-' read -r H_YEAR H_MONTH_NUM H_DAY <<< "$HDATE"
        H_MONTH_NAME=$(get_hijri_month_name "${H_MONTH_NUM:-2}")
        H_DAY_NAME=$(get_hijri_day_name "$DAY")
        H_NEXT_DAY_NAME=$(get_next_hijri_day_name "$H_DAY_NAME")

        LAST_CACHE_MTIME="$CURRENT_MTIME"
    fi

    ## These must run every second for the clock and blinker
    #TOGGLE=$(( $(date +%s) % 2 ))
    #NOW_HM=$(date +"%H:%M")
    #
    # BASH >=5.0 BUILT-INS: Zero forks. Instant execution.
    TOGGLE=$(( EPOCHSECONDS % 2 ))
    printf -v NOW_HM '%(%H:%M)T' -1  # Gets current HH:MM natively in bash

    # Compute all prayer colors once centrally for any formatter to use
    get_prayer_colors "$FJR" "$NOW_HM" "$TOGGLE" FJR_FG FJR_BG
    get_prayer_colors "$SYU" "$NOW_HM" "$TOGGLE" SYU_FG SYU_BG
    get_prayer_colors "$ZHR" "$NOW_HM" "$TOGGLE" ZHR_FG ZHR_BG
    get_prayer_colors "$ASR" "$NOW_HM" "$TOGGLE" ASR_FG ASR_BG
    get_prayer_colors "$MGH" "$NOW_HM" "$TOGGLE" MGH_FG MGH_BG
    get_prayer_colors "$ISY" "$NOW_HM" "$TOGGLE" ISY_FG ISY_BG

    # ==========================================
    # TEST BLOCK: UNCOMMENT ONE TO TEST BLINKING
    # ==========================================
    # 1. Test Amber Blink (20 mins in the future)
    #printf -v ZHR '%(%H:%M)T' "$(( EPOCHSECONDS + 1200 ))"

    # 2. Test Red Blink (5 mins in the future)
    # printf -v ZHR '%(%H:%M)T' "$(( EPOCHSECONDS + 300 ))"
    #printf -v ASR '%(%H:%M)T' "$(( EPOCHSECONDS + 300 ))"

    # 3. Test Solid Red (5 mins in the past / after prayer)
    # printf -v ZHR '%(%H:%M)T' "$(( EPOCHSECONDS - 300 ))"
    #printf -v MGH '%(%H:%M)T' "$(( EPOCHSECONDS - 300 ))"
    # ==========================================


    # Export context for child formatters
    #export ZONE SERVER_TIME IS_STALE DAY FJR SYU ZHR ASR MGH ISY TOGGLE NOW_HM \
    #       G_DATE_ISO G_MONTH_ABB G_DAY_ABB HDATE H_MONTH_NAME H_DAY_NAME \
    #       H_NEXT_DAY_NAME STATE_DIR
    export ZONE SERVER_TIME IS_STALE DAY FJR SYU ZHR ASR MGH ISY TOGGLE NOW_HM \
           G_DATE_ISO G_MONTH_ABB G_DAY_ABB HDATE H_MONTH_NAME H_DAY_NAME \
           H_NEXT_DAY_NAME STATE_DIR \
           FJR_FG FJR_BG SYU_FG SYU_BG ZHR_FG ZHR_BG \
           ASR_FG ASR_BG MGH_FG MGH_BG ISY_FG ISY_BG

    # Execute plugins
    run_formatters

    #sleep 1
    #
    # Sleep 0.5 prevents "beat frequency" aliasing with xmobar's internal polling interval
    sleep 0.5

done
